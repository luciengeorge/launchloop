# LaunchLoop environment variables.
# Copy to .env.local for local development. Every key is optional: anything
# missing falls back to a mock, so the full flow runs locally with no keys.

# --- Site -------------------------------------------------------------------
# Public base URL, used for metadata, sitemap, robots and email links.
# On Vercel it defaults to https://$VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3417

# Force every integration into mock mode even if keys are present (true/false).
MOCK_MODE=false

# --- LLM: Vercel AI Gateway via the AI SDK (one module: src/lib/llm.ts) ------
# On Vercel, requests authenticate with OIDC automatically (no key needed).
# Locally, either run `vercel link && vercel env pull` (writes VERCEL_OIDC_TOKEN,
# valid ~12h) or set an AI Gateway API key. An API key always wins over OIDC.
# With neither, copy generation uses deterministic mock templates.
AI_GATEWAY_API_KEY=
# Primary model and comma-separated fallbacks, as provider/model IDs from
# https://ai-gateway.vercel.sh/v1/models. Use "none" to disable fallbacks.
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.5
AI_GATEWAY_FALLBACK_MODELS=openai/gpt-5-mini
# Set to "mock" to force template copy even when gateway credentials exist.
LLM_PROVIDER=

# --- Stripe (Checkout) ------------------------------------------------------
# Without STRIPE_SECRET_KEY, checkout uses the built-in test page at /checkout/mock.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook (stripe listen prints one locally).
STRIPE_WEBHOOK_SECRET=
# Optional: use Prices from your Stripe dashboard instead of inline price data.
STRIPE_PRICE_KIT=
STRIPE_PRICE_SHIPLOOP_MONTHLY=
STRIPE_PRICE_SHIPLOOP_YEARLY=
# Optional: LAUNCH14 promotion code id (promo_...), applied to kit Checkout for the
# exp_launch14_promo treatment. Without it the active code named LAUNCH14 is looked up.
STRIPE_PROMO_LAUNCH14=

# --- Resend (email + newsletter audience) -----------------------------------
# Without RESEND_API_KEY, emails go to a local outbox at /api/dev/outbox.
RESEND_API_KEY=
# Must be on a domain verified in Resend for production.
RESEND_FROM=LaunchLoop <kits@launchloop.dev>
RESEND_REPLY_TO=hello@launchloop.dev
# Where newsletter / waitlist / buyer contacts go. Set one:
# RESEND_SEGMENT_ID (current Resend segments) or RESEND_AUDIENCE_ID (legacy audiences).
RESEND_SEGMENT_ID=
RESEND_AUDIENCE_ID=

# --- GitHub -----------------------------------------------------------------
# Optional. Raises the GitHub API rate limit from 60 to 5,000 requests/hour.
# A fine-grained token with no permissions (public repos only) is enough.
GITHUB_TOKEN=

# --- Storage ----------------------------------------------------------------
# Kits, orders and contacts are stored in a key-value store.
# Set these (Upstash Redis via the Vercel Marketplace) for production.
# Without them, JSON files are written to ./.data (or /tmp on Vercel, which is NOT durable).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Override the file-store directory.
DATA_DIR=

# --- PostHog (conversion analytics) ------------------------------------------
# Project API key (starts with phc_). Public by design: it's sent to browsers.
# Without it, no analytics events are sent anywhere (client or server).
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host for your project's region. Defaults to EU Cloud; use
# https://us.i.posthog.com for a US project. Read at build time for the
# /lp-relay proxy rewrites, so redeploy after changing it.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Ops --------------------------------------------------------------------
# Free previews per IP. Defaults: 5 an hour, 20 a day (PREVIEW_LIMITS in src/lib/site.ts),
# the numbers the terms, privacy page and pricing quote. Leave unset in production.
# PREVIEW_RATE_LIMIT_PER_HOUR=5
# PREVIEW_RATE_LIMIT_PER_DAY=20
# Newsletter signups per IP per hour (shared across instances). Default 10.
NEWSLETTER_RATE_LIMIT_PER_HOUR=10
# Newsletter welcome emails per day across everyone. Past it, signups still
# subscribe but get no welcome email. Default 200.
NEWSLETTER_WELCOME_DAILY_CAP=200
# Optional: signed-out (guest) kit checkouts per IP per hour. Defaults to 20.
CHECKOUT_RATE_LIMIT_PER_HOUR=
# --- Sentry -------------------------------------------------------------------
# Without a DSN, Sentry stays off. The server reads SENTRY_DSN (or falls back to
# NEXT_PUBLIC_SENTRY_DSN); the browser SDK needs NEXT_PUBLIC_SENTRY_DSN at build time.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: uploads source maps so stack traces are readable. Optional.
SENTRY_AUTH_TOKEN=
# Enables /api/sentry-test: send this value in the x-sentry-test-token header to
# trigger a test error (?mode=caught for a handled one). Unset = the route 404s.
SENTRY_TEST_TOKEN=
# Testing only: allow ingesting localhost/private URLs. Never enable in production.
INGEST_ALLOW_PRIVATE=false
